[Unit]
Description=Dashboard business application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
Group=dashboard
WorkingDirectory=/opt/dashboard/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4182
Environment=APP_ORIGIN=https://121.41.24.42
Environment=DATA_DIR=/var/lib/dashboard
ExecStart=/opt/dashboard/runtime/node-v24.16.0-linux-x64/bin/node server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dashboard

[Install]
WantedBy=multi-user.target
