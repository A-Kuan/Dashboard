# Copy to /etc/dashboard-sku/notifications.env with owner root:root and mode 0600.
# Supported types: dingtalk, wecom, generic.
ALERT_WEBHOOK_TYPE=dingtalk
ALERT_WEBHOOK_URL=
# DingTalk signed robots can set the signing secret below.
ALERT_WEBHOOK_SECRET=
# Repeated failures from the same source are suppressed for 30 minutes.
ALERT_COOLDOWN_SECONDS=1800
ALERT_TIMEOUT_MS=10000
