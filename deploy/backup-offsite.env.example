# Copy to /etc/dashboard-sku/backup-offsite.env with owner root:root and mode 0600.
# First enable upload with OFFSITE_BACKUP_REQUIRED=0, run one manual backup, then
# switch REQUIRED to 1 only after a complete .offsite.json receipt is present.
OFFSITE_BACKUP_ENABLED=0
OFFSITE_BACKUP_REQUIRED=0
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_PREFIX=production/dashboard-sku
# Recommended: attach this least-privilege RAM role to the ECS instance. The
# uploader requires IMDSv2 and obtains short-lived credentials for each run.
OSS_ECS_RAM_ROLE=
# Compatibility fallback only. Leave these empty when using an ECS RAM role.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_STS_TOKEN=
# OSS_ENDPOINT=
OSS_SERVER_SIDE_ENCRYPTION=AES256
OSS_TIMEOUT_MS=120000
