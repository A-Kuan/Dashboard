[Unit]
Description=Dashboard SKU API operational integrity check
After=dashboard-sku-api.service
Requires=dashboard-sku-api.service

[Service]
Type=oneshot
User=dashboard-sku
Group=dashboard-sku
WorkingDirectory=/opt/dashboard-sku-api/current
Environment=NODE_ENV=production
Environment=CATALOG_BACKUP_DIR=/opt/dashboard-sku-api/backups
ExecStart=/usr/bin/node scripts/check-operations.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/dashboard-sku-api
