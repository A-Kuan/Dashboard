# Optional public application name. Restart the dev server after changing it.
# VITE_ values are bundled into the browser: never put secrets here.
VITE_APP_NAME=Dashboard

# Server-only settings. Default development origin must match the browser URL.
HOST=127.0.0.1
PORT=4182
APP_ORIGIN=http://127.0.0.1:4179
DATA_DIR=.data
# Set NODE_ENV=production only behind HTTPS with an https APP_ORIGIN.
